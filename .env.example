# Database (Neon PostgreSQL)
DATABASE_JDBC_URL=jdbc:postgresql://your-neon-host.neon.tech/neondb?sslmode=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=your-database-password

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# JWT (REQUIRED in production; generate with: openssl rand -base64 48)
JWT_SECRET=replace-with-a-random-base64-secret-of-at-least-32-bytes

# Optional
# GEMINI_MODEL=gemini-2.0-flash
# APP_CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
